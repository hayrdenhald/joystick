{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "ignore": [
      "tsconfig.app.json",
      "tsconfig.node.json",
      "tsconfig.json",
      "src/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useFilenamingConvention": "error"
      },
      "correctness": {
        "noUnusedImports": {
          "level": "warn",
          "fix": "none"
        },
        "noUnusedVariables": "error"
      },
      "nursery": {
        "noImgElement": "error",
        "noHeadImportInDocument": "error",
        "noHeadElement": "error",
        "noDocumentImportInPage": "error",
        "useGoogleFontDisplay": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  }
}
